# Copy to .env (never commit .env). All variables are optional in development.
DATABASE_URL=postgres://tio:tio@localhost:5432/takeitover
PORT=8080
# postgis (needs `pnpm land:fetch && pnpm land:load`) or permissive (dev only: everything is land)
TIO_LAND_MASK=postgis
# Set true behind HTTPS (production). Defaults to true when NODE_ENV=production.
TIO_COOKIE_SECURE=false
# Extra origins allowed to make state-changing calls (comma separated), e.g. https://play.example.com
TIO_ALLOWED_ORIGINS=
# Serve the built PWA from this directory (packages/web/dist after `pnpm build`)
TIO_WEB_DIST=
# Optional JSON file overriding game parameters (validated; see docs/game-parameters.md)
TIO_PARAMS_FILE=
# Set true when running behind a reverse proxy that sets X-Forwarded-For
TIO_TRUST_PROXY=false
TIO_RATE_LIMIT_GLOBAL=300
TIO_RATE_LIMIT_AUTH=10
TIO_RATE_LIMIT_GPS=600
LOG_LEVEL=info
