# Copy to deploy/.env on the VPS (chmod 600; never commit it).

# Long random password for the game's own PostgreSQL (not your existing databases):
#   openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# Local port the existing reverse proxy forwards to (must be free: see inspect-vps.sh)
TIO_PORT=8087

# Where players reach the game:
#   own subdomain  → TIO_PUBLIC_PATH=/        TIO_ALLOWED_ORIGINS=https://play.example.com
#   path of a site → TIO_PUBLIC_PATH=/play/   TIO_ALLOWED_ORIGINS=https://example.com
TIO_PUBLIC_PATH=/
TIO_ALLOWED_ORIGINS=https://play.example.com

# Database image. Leave empty: deploy.sh picks postgis/postgis:16-3.4 on x86_64
# and imresamu/postgis:16-3.4 on ARM64. Never change the PostgreSQL major
# version (16) of an existing installation without a dump/restore.
TIO_DB_IMAGE=

# Resource caps (the VPS also runs other services). Measured with 100 players
# sending GPS every second: app ≤190 MiB and ≤1 CPU, database ≤140 MiB and
# ≤0.45 CPU; idle about 45 + 85 MiB.
TIO_DB_MEM_LIMIT=768m
TIO_APP_MEM_LIMIT=512m
TIO_DB_CPUS=0.5
TIO_APP_CPUS=1.0

LOG_LEVEL=info

# Where deploy.sh writes database backups, and how many days to keep them
TIO_BACKUP_DIR=/var/backups/takeitover
TIO_BACKUP_DAYS=14

# deploy.sh refuses to build when the server has less free memory than this
# (MiB), so a build can never squeeze the other services. The build peaks at
# about 650 MiB.
TIO_MIN_BUILD_MEM_MB=1000

# Extra flags for `docker build` (normally empty). Example behind a
# TLS-intercepting proxy: --secret id=extra_ca,src=/path/to/ca.pem
TIO_DOCKER_BUILD_FLAGS=
